# Gmail Workspace account the contact form sends through (must have
# 2-Step Verification enabled, using an App Password — not your login password).
# Generate one at https://myaccount.google.com/apppasswords
GMAIL_USER=reggie@vegashardscapedesign.com
GMAIL_APP_PASSWORD=

# Optional: where lead emails are delivered, if different from GMAIL_USER.
CONTACT_TO_EMAIL=reggie@vegashardscapedesign.com

# GA4 Measurement ID (Admin > Data Streams > your web stream, in
# analytics.google.com). Public — safe to expose client-side.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta (Facebook/Instagram) Pixel ID, from Events Manager > Datasets in
# business.facebook.com. Public — safe to expose client-side.
NEXT_PUBLIC_META_PIXEL_ID=

# Stripe (Bid Review checkout). Secret key from dashboard.stripe.com/apikeys.
# Webhook secret comes from the endpoint you register at
# dashboard.stripe.com/webhooks (or `stripe listen` locally) for
# checkout.session.completed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
